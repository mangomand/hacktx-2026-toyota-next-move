{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toyota-next-move/Finding/0.1.0",
  "title": "Finding",
  "type": "object",
  "required": [
    "id",
    "category",
    "severity",
    "confidence",
    "status",
    "regionId",
    "evidenceRefs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "category": {
      "enum": [
        "visible_damage",
        "wear",
        "warning_indicator",
        "missing_context",
        "unknown"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "observed",
        "needs_review",
        "unseen",
        "not_a_diagnosis"
      ]
    },
    "regionId": {
      "enum": [
        "front",
        "front-left",
        "left",
        "rear-left",
        "rear",
        "rear-right",
        "right",
        "front-right",
        "roof",
        "interior-front",
        "interior-rear",
        "trunk"
      ]
    },
    "description": {
      "type": "string"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "recommendedCheck": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
